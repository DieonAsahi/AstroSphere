# ==============================================================================
# Edu Planet 3D (AstroSphere) - Konfigurasi Environment Variables Lokal & Vercel
# Salin berkas ini ke `.env.local` untuk pengembangan lokal atau atur di Vercel Dashboard.
# ==============================================================================

# Supabase API Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# URL Basis Situs (Digunakan oleh getBaseUrl() di Vercel/Local)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Kompatibilitas Vite Dev
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
