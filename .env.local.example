# ==============================================================================
# Edu Planet 3D (AstroSphere) - Konfigurasi Environment Variables Lokal & Vercel
# Salin berkas ini ke `.env.local` untuk pengembangan lokal atau atur di Vercel Dashboard.
# ==============================================================================

# Sumber Data: 'json' (fase MVP offline) atau 'supabase' (fase produksi/database)
DATA_SOURCE=supabase

# Supabase API Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# CDN / Penyedia Penyimpanan Aset 3D & Tekstur Besar
STORAGE_CDN_URL=https://your-project.supabase.co/storage/v1/object/public/astrosphere-assets

# Vercel Web Analytics & Speed Insights ('true' atau 'false')
VERCEL_ANALYTICS_ENABLED=false

# Sentry DSN untuk Pelaporan Galat
SENTRY_DSN=

# URL Basis Situs
APP_URL=http://localhost:3000
