  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^7.0.1",
