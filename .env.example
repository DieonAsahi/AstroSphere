# ==============================================================================
# AstroSphere Environment Variables Configuration
# Salin berkas ini ke .env.local untuk pengembangan lokal atau atur di Vercel Dashboard
# ==============================================================================

# Sumber Data: 'json' (fase MVP offline) atau 'supabase' (fase produksi/database)
VITE_DATA_SOURCE=json

# Konfigurasi Supabase Project (Diperoleh dari Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# CDN / Penyedia Penyimpanan Aset 3D & Tekstur Besar (Supabase Storage / Cloudflare CDN)
# Kosongkan untuk menggunakan folder publik lokal /assets/
VITE_STORAGE_CDN_URL=https://your-project-ref.supabase.co/storage/v1/object/public/astrosphere-assets

# Vercel Web Analytics & Speed Insights ('true' atau 'false')
VITE_VERCEL_ANALYTICS_ENABLED=false

# Sentry DSN untuk Pelaporan Galat Ramah Privasi (UU PDP No. 27/2022)
# Kosongkan jika tidak menggunakan Sentry
VITE_SENTRY_DSN=

# URL Basis Aplikasi (Digunakan untuk pengalihan email verifikasi & reset kata sandi)
VITE_APP_URL=https://astrosphere.vercel.app

