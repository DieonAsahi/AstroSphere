# ==============================================================================
# AstroSphere Environment Variables Configuration
# Salin berkas ini ke .env untuk pengembangan lokal atau atur di Vercel Dashboard
# ==============================================================================

# Mode Sumber Data: 'auto' (default), 'supabase' (wajib database), atau 'local' (offline data dummy)
DATA_SOURCE=auto

# Konfigurasi Supabase Project (Didapat dari Supabase Dashboard -> Project Settings -> API)
# Didukung baik format SUPABASE_* maupun NUXT_PUBLIC_SUPABASE_* / VITE_SUPABASE_*
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# URL Basis Aplikasi
APP_URL=https://astrosphere.vercel.app
